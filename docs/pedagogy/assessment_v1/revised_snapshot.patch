+def reserve_run_directory(checkpoint_dir):
+    """Protect existing work before allocating a model or opening any outputs.
+
+    The exclusive reservation also prevents two new runs racing for one empty
+    directory. An interrupted startup keeps its reservation: use a new folder.
+    Resume is deliberately a course exercise, not an implicit overwrite mode.
+    """
+    path = Path(checkpoint_dir)
+    path.mkdir(parents=True, exist_ok=True)
+    message = (f"Run folder '{path}' already contains files. Nothing was overwritten. "
+               "Choose a NEW folder, for example --checkpoint-dir runs/m6_smoke_02. "
+               "To continue an old run, first complete Module 6's resume exercise.")
+    if any(path.iterdir()):
+        raise FileExistsError(message)
+    try:
+        with (path / ".run-started").open("x") as reservation:
+            reservation.write("Reserved for one training run.\n")
+    except FileExistsError:
+        raise FileExistsError(message) from None
+    return path
