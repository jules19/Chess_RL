+def _sha256(path):
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as source:
+        for chunk in iter(lambda: source.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def save_completed_iteration(directory, champion, candidate, buffer, iteration, log_text):
+    """Publish a complete, immutable iteration before updating convenience files.
+
+    completed.json is replaced atomically only after all snapshot files exist.
+    A stopped write leaves the previous marker usable. Snapshots are retained
+    (including buffers), trading disk space for recoverable experiment history.
+    This protects process interruptions; it is not a power-loss durability claim.
+    """
+    directory = Path(directory)
+    snapshots = directory / "iterations"
+    snapshots.mkdir(exist_ok=True)
+    snapshot = Path(tempfile.mkdtemp(prefix=f"iter_{iteration:06d}_", dir=snapshots))
+    save_checkpoint(champion, snapshot / "champion.pt", iteration)
+    save_checkpoint(candidate, snapshot / "candidate.pt", iteration)
+    buffer.save(str(snapshot / "replay_buffer.npz"))
+    (snapshot / "run_log.csv").write_text(log_text)
+    marker = {
+        "iteration": iteration,
+        "snapshot": snapshot.relative_to(directory).as_posix(),
+        "sha256": {name: _sha256(snapshot / name) for name in
+                   ("champion.pt", "candidate.pt", "replay_buffer.npz", "run_log.csv")},
+    }
+    pending_marker = directory / "completed.json.tmp"
+    pending_marker.write_text(json.dumps(marker, indent=2) + "\n")
+    os.replace(pending_marker, directory / "completed.json")
+
+    # Existing play/evaluation commands can still use these top-level paths.
+    # Recovery must use completed.json, since interruption can leave these stale.
+    for source, destination in (("champion.pt", "champion.pt"),
+                                ("candidate.pt", f"candidate_iter_{iteration}.pt"),
+                                ("replay_buffer.npz", "replay_buffer.npz"),
+                                ("run_log.csv", "run_log.csv")):
+        temporary = directory / (destination + ".tmp")
+        shutil.copyfile(snapshot / source, temporary)
+        os.replace(temporary, directory / destination)
