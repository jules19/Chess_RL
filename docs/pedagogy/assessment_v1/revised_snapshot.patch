+"""Experiment files must survive reruns and interrupted iteration writes."""
+
+import json
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+torch = pytest.importorskip('torch')
+
+from net.model import create_model
+from selfplay.replay_buffer import ReplayBuffer
+from selfplay import train_loop as loop
+
+
+@pytest.fixture(autouse=True)
+def one_thread():
+    previous = torch.get_num_threads()
+    torch.set_num_threads(1)
+    yield
+    torch.set_num_threads(previous)
+
+
+def tiny_run(path, **kwargs):
+    options = dict(iterations=1, games_per_iter=1, simulations=2, train_steps=1,
+                   batch_size=2, arena_games=2, max_moves=4, res_blocks=1,
+                   channels=8, device='cpu', seed=7, verbose=False,
+                   checkpoint_dir=str(path))
+    options.update(kwargs)
+    return loop.run_training_loop(**options)
+
+
+def test_rerun_refuses_before_touching_any_saved_results(tmp_path, monkeypatch):
+    folder = tmp_path / 'run'
+    tiny_run(folder)
+    original = {p.relative_to(folder): p.read_bytes() for p in folder.rglob('*') if p.is_file()}
+    def must_not_construct_model(*args, **kwargs):
+        pytest.fail('occupied directory must be refused before creating a model')
+    monkeypatch.setattr(loop, 'create_model', must_not_construct_model)
+    with pytest.raises(FileExistsError, match='--checkpoint-dir runs/m6_smoke_02'):
+        tiny_run(folder)
+    assert original == {p.relative_to(folder): p.read_bytes() for p in folder.rglob('*') if p.is_file()}
+
+
+def test_even_an_unrelated_file_is_preserved(tmp_path):
+    (tmp_path / 'notes.txt').write_text('keep this')
+    with pytest.raises(FileExistsError, match='Nothing was overwritten'):
+        loop.reserve_run_directory(tmp_path)
+    assert list(tmp_path.iterdir()) == [tmp_path / 'notes.txt']
+
+
+def test_config_records_loaded_architecture_and_actual_settings(tmp_path):
+    warm_start = tmp_path / 'warm.pt'
+    loop.save_checkpoint(create_model(num_res_blocks=1, num_channels=8), warm_start, 0)
+    folder = tmp_path / 'run'
+    tiny_run(folder, init_checkpoint=warm_start, res_blocks=4, channels=128)
+    config = json.loads((folder / 'config.json').read_text())
+    settings = config['settings']
+    assert (settings['res_blocks'], settings['channels']) == (1, 8)
+    assert settings['arena_simulations'] == 2
+    assert settings['seed'] == 7 and settings['device'] == 'cpu'
+    assert settings['init_checkpoint'] == str(warm_start)
+    assert config['torch_version'] and config['created_utc']
+
+
+def test_completed_snapshot_contains_matching_state_and_log(tmp_path):
+    folder = tmp_path / 'run'
+    tiny_run(folder)
+    marker = json.loads((folder / 'completed.json').read_text())
+    snapshot = folder / marker['snapshot']
+    for name, digest in marker['sha256'].items():
+        assert loop._sha256(snapshot / name) == digest
+    checkpoint = torch.load(snapshot / 'champion.pt', weights_only=True)
+    assert checkpoint['selfplay_iteration'] == marker['iteration'] == 1
+    assert (snapshot / 'run_log.csv').read_text().splitlines()[-1].startswith('1,4,')
+    assert len(ReplayBuffer.load(snapshot / 'replay_buffer.npz')) == 4
+    for name in ('champion.pt', 'replay_buffer.npz', 'run_log.csv'):
+        assert (folder / name).read_bytes() == (snapshot / name).read_bytes()
+
+
+def test_interrupted_snapshot_keeps_previous_commit_usable(tmp_path, monkeypatch):
+    folder = tmp_path / 'run'
+    champion = tiny_run(folder)
+    before = (folder / 'completed.json').read_bytes()
+    old_log = (folder / 'run_log.csv').read_bytes()
+    buffer = ReplayBuffer(capacity=10)
+    buffer.add(np.zeros((20, 8, 8)), np.zeros(4672), 0)
+    def interrupted_save(path):
+        Path(path).write_bytes(b'incomplete buffer')
+        raise OSError('simulated interrupted write')
+    monkeypatch.setattr(buffer, 'save', interrupted_save)
+    with pytest.raises(OSError, match='interrupted'):
+        loop.save_completed_iteration(folder, champion, champion, buffer, 2, 'new log')
+    assert (folder / 'completed.json').read_bytes() == before
+    assert (folder / 'run_log.csv').read_bytes() == old_log
+    marker = json.loads(before)
+    for name, digest in marker['sha256'].items():
+        assert loop._sha256(folder / marker['snapshot'] / name) == digest
